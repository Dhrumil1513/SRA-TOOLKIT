#Heatmap(abc_mat, col = c("#E0FFE5", "#2ECC71", "#0D4F2C"), row_names_side = 'right', column_names_side = 'bottom',  column_names_gp = grid::gpar(fontsize = 20), column_names_rot = 60,
        #row_names_gp = grid::gpar(fontsize = 10),heatmap_legend_param = list(title = "ANI %", title_gp = gpar(fontsize = 15),labels_gp = gpar(fontsize = 14)))
Heatmap(abc_mat, 
        col =c('#E0FFE5', '#2ECC71', '#0D4F2C'), 
        row_names_side = 'right', 
        column_names_side = 'bottom',
        column_names_gp = grid::gpar(fontsize = 18),
