import pandas as pd
from scipy.stats import ttest_ind
from statsmodels.stats.multitest import multipletests
# Load matrix (samples x features + phenotype column)
metadata = pd.read_csv("y_train42a_with_index.csv")
data1 = pd.read_csv("x_train42a.csv")
data = pd.merge(metadata, data1, on="genome")

print(data.head())
# Split groups
#resistant = data[data["AMR"] == "1"] ##.drop(columns=["AMR"])
#sensitive = data[data["AMR"] == "0"]###.drop(columns=["AMR"])
data["AMR"] = data["AMR"].astype(int)
resistant = data[data["AMR"] == 1]
sensitive = data[data["AMR"] == 0]

print(resistant.head())
print(sensitive.head())

resistant1 = resistant.drop(columns=["AMR"])
sensitive1 = sensitive.drop(columns=["AMR"])
resistant2 = resistant1.reset_index(drop=True)
sensitive2 = sensitive1.reset_index(drop=True)

print(resistant2.head())
print(sensitive2.head())

#resistant3 = resistant2.drop(columns=["genome"])
#sensitive3 = sensitive2.drop(columns=["genome"])

#print(resistant3.head())
#print(sensitive3.head())
numeric_cols = resistant2.select_dtypes(include=["number"]).columns
results = []
for col in numeric_cols:
    _, p_val = ttest_ind(resistant2[col], sensitive2[col], equal_var=False)
    results.append((col, p_val))

