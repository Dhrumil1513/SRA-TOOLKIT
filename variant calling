 bwa mem -t 40 ./GCA_030014125.1_ASM3001412v1_genomic.fna ./CSH_1_R1.fq.gz ./CSH_1_R2.fq.gz | samtools view -b -h -o CSH_1.bam
picard -Xmx7g SortSam -I CSH_1.bam -O CSH_1.sort.bam -VALIDATION_STRINGENCY LENIENT -SORT_ORDER coordinate -MAX_RECORDS_IN_RAM 3000000 -CREATE_INDEX true
######## add read group information
picard AddOrReplaceReadGroups I=CSH_1.sort.bam O=CSH_1.rg.bam RGID=group1 RGLB=lib1 RGPL=illumina RGPU=unit1 RGSM=sample1
picard -Xmx7g MarkDuplicates -I CSH_1.rg.bam -O CSH_1.rg.dup.bam -M marked_dup_metrics.txt     (mark duplicates)
###### prestep before making vcf files
picard CreateSequenceDictionary R=GCA_030014125.1_ASM3001412v1_genomic.fna O=GCA_030014125.1_ASM3001412v1_genomic.dict
samtools index CSH_1.rg.dup.bam  ## index the files
gatk HaplotypeCaller -R GCA_030014125.1_ASM3001412v1_genomic.fna -I CSH_1.rg.dup.bam -O variants.vcf

 gatk VariantFiltration -R GCA_030014125.1_ASM3001412v1_genomic.fna -V variants.vcf -O variants.filtered.vcf --filter-expression "QD < 2.0 || FS > 60.0 || MQ < 40.0" --filter-name "basic_snp_filter"

####variant calling VEP  tool
conda create -n vep_env ensembl-vep htslib bcftools perl-bio-db-hts -y
gffread annotation.gff3 -T -o annotation.gtf
samtools faidx genome.fa
vep -i CSH_1_variants.filtered.vcf -o CSH_1_variants.ann.vep.vcf --fasta GCA_030014125.1_ASM3001412v1_genomic.fna --gff GCA_030014125.1_ASM3001412v1_genomic.gff3 --species fusarium_solani
###annotation by snippy tool     snipyy annotate -i CSH_1_variants.filtered.vcf -r GCA_030014125.1_ASM3001412v1_genomic.fna -g GCA_030014125.1_ASM3001412v1_genomic.gff3 -o CSH_1_fusarium_annotated.vcf --vcf
