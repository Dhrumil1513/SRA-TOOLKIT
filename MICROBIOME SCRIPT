#PAIRED WILCOXON TEST FOR EVERY GENUS


species_test <- species_long %>%
  group_by(species) %>%
  group_modify(~ {
    
    # Convert to patient × site format
    temp <- .x %>%
      select(Patient, Site, Relative_Abundance) %>%
      pivot_wider(
        names_from = Site,
        values_from = Relative_Abundance
      )
    
    # Need both L2 and L3
    if(
      !"L2" %in% colnames(temp) ||
      !"L3" %in% colnames(temp)
    ) {
      return(
        data.frame(
          L2_Median = NA,
          L3_Median = NA,
          Difference = NA,
          P_value = NA
        )
      )
    }
    
    # Remove incomplete pairs
    temp <- temp %>%
      filter(
        !is.na(L2),
        !is.na(L3)
      )
    
    # Paired Wilcoxon
    if(nrow(temp) < 2) {
      
      p <- NA
      
    } else {
      
      p <- wilcox.test(
        temp$L2,
        temp$L3,
        paired = TRUE,
        exact = FALSE
      )$p.value
    }
    
    data.frame(
      L2_Median = median(temp$L2, na.rm = TRUE),
      L3_Median = median(temp$L3, na.rm = TRUE),
      Difference = median(
        temp$L2 - temp$L3,
        na.rm = TRUE
      ),
      P_value = p
    )
  }) %>%
  ungroup()

species_test <- species_test %>%
  mutate(
    FDR = p.adjust(
      P_value,
      method = "BH"
    )
  )

species_test <- species_test %>%
  mutate(
    Enriched = case_when(
      
      Difference > 0 ~ "L2",
      
      Difference < 0 ~ "L3",
      
      TRUE ~ "Equal"
    )
  )


species_test <- species_test %>%
  arrange(FDR)

