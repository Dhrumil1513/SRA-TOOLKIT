  stringsAsFactors = FALSE
)

# Convert to numeric
abundance[] <- lapply(
  abundance,
  function(x) as.numeric(as.character(x))
)

# Remove taxa with zero total abundance
abundance <- abundance[
  rowSums(abundance, na.rm = TRUE) > 0,
  ,
  drop = FALSE
]

cat("Taxa:", nrow(abundance), "\n")
cat("Samples:", ncol(abundance), "\n")

metadata_new <- read.csv("metadata.csv", stringsAsFactors = FALSE)
patient_samples <- c(
  "barcode89", "barcode91", "barcode87", "barcode92", "barcode86", "barcode93", "barcode85", "barcode88", "barcode90", "barcode84"
)

abundance_patient <- abundance[
  ,
  patient_samples,
  drop = FALSE
]

# Sample x taxa
otu <- t(as.matrix(abundance_patient))

# Relative abundance
otu_rel <- sweep(
  otu,
  1,
  rowSums(otu),
  "/"
)
# Bray-Curtis

bray <- vegdist(
  otu_rel,
  method = "bray"
)

# PCoA

pcoa <- cmdscale(
  bray,
  k = 2,
  eig = TRUE,
  add = TRUE
)

# Variance
eig <- pcoa$eig
eig_pos <- eig[eig > 0]

PC1 <- round(
  100 * eig_pos[1] / sum(eig_pos),
  1
)

PC2 <- round(
  100 * eig_pos[2] / sum(eig_pos),
  1
)


