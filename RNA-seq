#Install the required programs using anaconda
conda create -N RNA-seq 

conda install -n RNA-seq -c bioconda fastqc
conda install -n RNA-seq -c bioconda fastp
conda install -n RNA-seq -c bioconda multiqc
conda install -n RNA-seq -c bioconda star
conda install -n RNA-seq -c bioconda samtools
conda install -n RNA-seq -c bioconda deeptools
conda install -n RNA-seq -c bioconda salmon

###check the quality sequence
fastqc Fusarium_mat_Day_2_R1.fastq.gz
fastqc Fusarium_mat_Day_2_R2.fastq.gz
totalreads=$(unzip -c Fusarium_mat_Day_2_R2_fastqc.zip Fusarium_mat_Day_2_R2_fastqc/fastqc_data.txt | grep 'Total Sequences' | cut -f 2)
echo $totalreads    ###To extract the total number of reads from the fastQC report
###triming the adaptors
fastp -i Fusarium_mat_Day_2_R1.fastq.gz -I Fusarium_mat_Day_2_R2.fastq.gz -o Fusarium_mat_Day_2_R1.trimmed.fastq.gz -O Fusarium_mat_Day_2_R2.trimmed.fastq.gz --detect_adapter_for_pe -l 25 -j Fusarium_mat_Day_2.fastp.json -h Fusarium_mat_Day_2.fastp.html
###see the html file
###download reference genome
###this suggested in available script wget ftp://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.gz
wget https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_36/GRCh37_mapping/gencode.v36lift37.annotation.gtf.gz
gunzip gencode.v36lift37.annotation.gtf.gz
STAR --runThreadN 4 --runMode genomeGenerate --genomeDir $GENOMEDIR --genomeFastaFiles $GENOMEDIR/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna --sjdbGTFfile $GENOMEDIR/gencode.v36lift37.annotation.gtf --sjdbOverhang 150
### replace  $GENOMEDIR with path
###sort bam file
samtools sort Fusarium_mat_Day_2_Aligned.out.bam > Fusarium_mat_Day_2_Aligned.out.bam-sorted.bam
 samtools flagstat Fusarium_mat_Day_2_Aligned.out.bam-sorted.bam > Fusarium_mat_Day_2_Aligned.out.bam-sorted.flagstat
###Run qualimap to generate QC reports
qualimap bamqc -bam Fusarium_mat_Day_2_Aligned.out.bam-sorted.bam -gff /lustre/sisodiya.d/pinal/1_Raw_Data/indexed_genome/gencode.v36lift37.annotation.gtf -outdir Fusarium_mat_Day_2_Aligned.out.bam-bamqc-qualimap-report --java-mem-size=16G
qualimap rnaseq -bam Fusarium_mat_Day_2_Aligned.out.bam-sorted.bam -gtf /lustre/sisodiya.d/pinal/1_Raw_Data/indexed_genome/gencode.v36lift37.annotation.gtf -outdir Fusarium_mat_Day_2_Aligned.out.bam-rnaseq-qualimap-report --java-mem-size=16G

conda install bioconda::ucsc-fatotwobit -y ## to convert genome file to .2bit format to check GC bias.
faToTwoBit GCA_000001405.15_GRCh38_no_alt_analysis_set.fna GCA_000001405.15_GRCh38_no_alt_analysis_set.2bit
###install deeptools
conda create -y -n deeptools_env python=3.8 deeptools -c bioconda -c conda-forge
##index the bam file first
samtools index Fusarium_mat_Day_2_Aligned.out.bam-sorted.bam
##now run for compute GC bias
computeGCBias -b Fusarium_mat_Day_2_Aligned.out.bam-sorted.bam --effectiveGenomeSize 3099922541 -g indexed_genome/GCA_000001405.15_GRCh38_no_alt_analysis_set.2bit -l 100 --GCbiasFrequenciesFile Fusarium_mat_Day_2_Aligned.out.bam.freq.txt  --biasPlot Fusarium_mat_Day_2_Aligned.out.bam.biasPlot.pdf

